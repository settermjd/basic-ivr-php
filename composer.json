{
    "name": "settermjd/basic-ivr-php",
    "description": "This app shows how to build a basic IVR (Interactive voice response) system with PHP and Twilio.",
    "version": "0.0.1",
    "type": "project",
    "license": "MIT",
    "keywords": [
        "Slim",
        "Twilio",
        "IVR",
        "Webhooks"
    ],
    "config": {
        "sort-packages": true
    },
    "require": {
        "slim/slim": "^4.14",
        "slim/psr7": "^1.7",
        "twilio/sdk": "^8.8",
        "monolog/monolog": "^3.7",
        "php-di/slim-bridge": "^3.4",
        "vlucas/phpdotenv": "^5.6"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0",
        "slim/http": "^1.2",
        "squizlabs/php_codesniffer": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "serve": [
            "Composer\\Config::disableProcessTimeout",
            "php -S 0.0.0.0:8080 -t public/"
        ],
        "test": "phpunit",
        "lint": "vendor/bin/phpcs src public tests"
    }
}